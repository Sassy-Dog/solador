# Solador per-host metrics agent (user systemd unit).
#
# Generated by deploy/install.sh from agent/deploy/solador-agent.service, with
# ExecStart rendered to the absolute path the binary was actually installed at
# (#392); every install re-run regenerates this file (the displaced one is kept
# as .service.prev), so put overrides in a drop-in (`systemctl --user edit
# solador-agent`) rather than editing this file. A hand-edited path is how a
# stale binary keeps serving after a "successful" install.
#
# Runs as the invoking user so rootless `podman ps` works without sudo.
# (`loginctl enable-linger <user>` so it survives logout / starts on boot.)

[Unit]
Description=Solador metrics agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@SOLADOR_AGENT_BIN@
EnvironmentFile=%h/.config/solador-agent.env
Restart=always
RestartSec=3
# Light hardening (user service; keep permissive enough for podman socket access).
NoNewPrivileges=true

[Install]
WantedBy=default.target
