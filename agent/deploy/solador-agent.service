# Solador per-host metrics agent (user systemd unit).
#
# Generated by deploy/install.sh from agent/deploy/solador-agent.service, with
# ExecStart rendered to the absolute path the binary was actually installed at
# (#392); every install re-run regenerates this file (the displaced one is kept
# as .service.prev), so put overrides in a drop-in (`systemctl --user edit
# solador-agent`) rather than editing this file. A hand-edited path is how a
# stale binary keeps serving after a "successful" install.
#
# Runs as the invoking user so rootless `podman ps` works without sudo.
# (`loginctl enable-linger <user>` so it survives logout / starts on boot.)

[Unit]
Description=Solador metrics agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@SOLADOR_AGENT_BIN@
# Where SOLADOR_AGENT_TLS=1 finds/creates solador-agent.tls.key/
# solador-agent.tls.crt (#447): the SAME directory EnvironmentFile= reads
# the env file out of, both keyed off %h (a systemd specifier the manager
# resolves from the target user's own account, never this process's
# inherited HOME) so the two can never point at different directories the
# way `$HOME` alone could on a host where a process's HOME does not match
# its account's. main.rs's tls_config_dir() reads this before falling back
# to $HOME/.config on its own. Never set SOLADOR_AGENT_CONFIG_DIR in the
# env file itself: EnvironmentFile= would then override this line, and the
# health checks would pin a different directory from the one the agent
# actually serves out of.
Environment=SOLADOR_AGENT_CONFIG_DIR=%h/.config
EnvironmentFile=%h/.config/solador-agent.env
Restart=always
RestartSec=3
# Light hardening (user service; keep permissive enough for podman socket access).
NoNewPrivileges=true

[Install]
WantedBy=default.target
