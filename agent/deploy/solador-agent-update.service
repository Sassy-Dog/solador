# Solador metrics agent: the unattended update check (user systemd unit, #394).
#
# Generated by deploy/install.sh --enable-timer from
# agent/deploy/solador-agent-update.service, with ExecStart and the guard's
# two lines rendered to the absolute paths this host actually installed at; a
# re-run WITH the flag regenerates this file, a re-run without it leaves it
# alone. It exists only on a host whose operator opted in — a default install
# writes no updater.
#
# A separate unit from solador-agent.service on purpose: `solador-agent
# update` restarts the metrics service and then verifies (and, on failure,
# restores) it. Run from inside that service's cgroup, the restart would kill
# the process doing the verifying. Started by solador-agent-update.timer and
# nothing else; `systemctl --user start solador-agent-update` by hand is the
# operator's explicit choice and goes through the same guard (exactly like
# `launchctl kickstart` on macOS); `solador-agent update` typed directly does
# not.
#
# No EnvironmentFile=: the updater resolves the metrics unit and reads
# ~/.config/solador-agent.env itself, under EnvironmentFile= rules, and the
# token goes into exactly one place (the local health probe's header). Copying
# the file into this process's environment would be a second exposure for no
# reader. HOME comes from the user manager, which is where the install is
# resolved under — and where the guard keeps its stamp.
#
# The guard (#411). ExecCondition= runs ~/.local/bin/solador-agent-update-guard
# before ExecStart on every activation, and it holds the cadence decision —
# DAILY, NO CATCH-UP — that the timer's monotonic clock carries in ordinary
# operation but not across a daemon-reload followed by a suspend/resume (the
# timer file has the trace). Its exit status is systemd's own contract:
# 0 runs `update`; 1 skips it cleanly (a firing within five minutes of the
# last resume or boot, or within 23 h of the last attempt — the unit ends
# inactive, not failed, with the reason in the journal); 255 fails the unit
# (an input the guard could not read, or a stamp it could not write — visible
# in `systemctl --user --failed`, because a hold does not resolve by itself).
# `%n` hands the guard this unit's name, which is how it reads its own
# activation time back from the manager. AssertFileIsExecutable= is the
# guard's presence check: a condition binary that is NOT THERE is exec
# failure 203, which is inside ExecCondition's skip range, and a unit whose
# guard was deleted would otherwise skip every firing forever with
# Result=success; the assertion makes that an error line in the journal and
# a failed `start` instead. ExecCondition= needs systemd >= 243; the installer
# refuses the opt-in on an older manager rather than let the line be ignored.

[Unit]
Description=Solador metrics agent: unattended update check
After=network-online.target solador-agent.service
Wants=network-online.target
AssertFileIsExecutable=@SOLADOR_AGENT_GUARD_PATH@

[Service]
Type=oneshot
ExecCondition=@SOLADOR_AGENT_GUARD@ %n
ExecStart=@SOLADOR_AGENT_BIN@ update
# Exit 4 is "no applicable release" — the feed is not newer than what is
# installed, which a from-source host running ahead of the last tag answers
# every single day. It is not a failure and must not paint the unit red or
# land in `systemctl --failed`; the updater's own line saying so is still in
# the journal. Every other non-zero exit (1 refused, 3 not recovered, 5
# recovered, 75 busy) stays a failed run, visible as one. (This maps
# ExecStart's status only; the guard's 1 and 255 are ExecCondition's own.)
SuccessExitStatus=4
NoNewPrivileges=true
