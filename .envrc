# direnv configuration. Run `direnv allow` once; after that these are exported
# whenever you cd into the repository.
#
# This file is committed and contains no values. Real ones go in `.envrc.local`,
# which is gitignored:
#
#     # .envrc.local
#     export SENTRY_DSN="https://…@….ingest.sentry.io/…"
#     export DEVELOPMENT_TEAM="XXXXXXXXXX"
#
# Both are OPTIONAL, and nothing in the day-to-day loop needs them:
#
#   ./dev            works — the app runs
#   ./dev test       works
#   ./dev lint       works
#   ./dev build      works — Xcode picks a signing team, Sentry no-ops
#   ./dev publish    needs SENTRY_DSN, or an explicit --skip-sentry
#
# So a contributor can ignore this file entirely. It exists so that the one
# person cutting releases does not have to remember to export things by hand.
#
# If you pull these from a secret manager, do it here in `.envrc.local` — e.g.
#     eval "$(your-cli export --format shell)"
# No build script knows or cares where the values came from, which is the whole
# arrangement: a script that knows the source has to be edited every time the
# source changes, and every contributor has to learn the answer.

source_env_if_exists .envrc.local
