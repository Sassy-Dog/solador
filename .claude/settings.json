{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/Scripts/format-hook.sh",
            "timeout": 30,
            "statusMessage": "Formatting Swift…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sassydog-post-edit.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "sassy-dog@sassydog-skills": true
  },
  "extraKnownMarketplaces": {
    "sassydog-skills": {
      "source": {
        "source": "github",
        "repo": "Sassy-Dog/sassydog-skills"
      }
    }
  }
}
