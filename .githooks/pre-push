#!/usr/bin/env bash
set -euo pipefail

# Pre-push gate: mirror CI's Lint job locally so a lint/format failure is caught
# here, not after a full CI round-trip. Install with: ./scripts/install-hooks.sh
# Bypass a single push with: git push --no-verify

REPO_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
cd "$REPO_ROOT"

if ! ./dev lint </dev/null; then
    echo "❌ pre-push blocked: lint failed — fix the above, or bypass with: git push --no-verify" >&2
    exit 1
fi
