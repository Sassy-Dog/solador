{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solador",
  "identifier": "app.solador.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Solador",
        "width": 1000,
        "height": 1120,
        "resizable": true,
        "minWidth": 200,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Sassy-Dog/solador/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1OUExMkE1RDVFMTE2NzIKUldSeUZ1SFZwUkthdFFRZk5TMHp0ak11Q3F5WW9iOWRSV25Tb3luYUpINW40aTdORWhwMFRUaHcK"
    }
  }
}
